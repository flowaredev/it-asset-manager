@using System.IO
@using System.Security.Claims
@using Microsoft.Extensions.Configuration
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMessageService MessageService
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<HeaderTitle Title="@Title" />

<Button Margin="Margin.Is2.OnY" Color="Color.Primary" Clicked="OpenNewDocumentModal">새글 등록</Button>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <Alert Margin="Margin.Is2.FromTop" Color="@_statusColor" Visible="true">
        @_statusMessage
    </Alert>
}

<Field Margin="Margin.Is4.FromTop">
    <FieldLabel>등록된 글 목록</FieldLabel>
</Field>

<DataGrid TItem="OperationDocument"
          Data="@_documents"
          ShowPager="true"
          ShowPageSizes="true"
          Responsive="true"
          Sortable="true"
          SortMode="DataGridSortMode.Single"
          Filterable="true"
          FilterMode="DataGridFilterMode.Menu">
    <DataGridColumns>
        <DataGridColumn Field="@nameof(OperationDocument.Content)" Caption="내용">
            <DisplayTemplate>
                <Text>@context.Content</Text>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn Field="@nameof(OperationDocument.UpdatedAt)" Caption="수정일시">
            <DisplayTemplate>
                @context.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn Field="@nameof(OperationDocument.AuthorUserName)" Caption="작성자">
            <DisplayTemplate>
                @FormatAuthor(context.AuthorUserName, context.AuthorName)
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn Field="@nameof(OperationDocument.Id)" Caption="작업" Sortable="false" Filterable="false">
            <DisplayTemplate>
                <Buttons Size="Size.Small">
                    <Button Color="Color.Primary"
                            Size="Size.Small"
                            Clicked="@(() => OpenDocumentModal(context))">
                        @(CanManageDocument(context) ? "수정" : "상세")
                    </Button>
                    @if (CanManageDocument(context))
                    {
                        <Button Color="Color.Danger"
                                Size="Size.Small"
                                Clicked="@(async () => await DeleteDocumentAsync(context.Id))">
                            삭제
                        </Button>
                    }
                </Buttons>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
    <EmptyTemplate>
        등록된 글이 없습니다.
    </EmptyTemplate>
</DataGrid>

<Modal @ref="_documentModal">
    <ModalContent Centered="true" Scrollable="true" Size="ModalSize.ExtraLarge">
        <ModalHeader>
            <ModalTitle>글 상세 및 수정</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            @if (_selectedDocument is not null)
            {
                var selectedDocument = _selectedDocument;

                <OperationDocumentCard @key="_selectedDocumentKey"
                                       Document="@selectedDocument"
                                       Comments="@GetCommentsForDocument(selectedDocument.Id)"
                                       Attachments="@GetAttachmentsForDocument(selectedDocument.Id)"
                                       IsAdministrator="@_isAdministrator"
                                       CurrentUserName="@_currentUserName"
                                       DocumentUpdated="UpdateSelectedDocumentAsync"
                                       DocumentDeleted="DeleteSelectedDocumentAsync"
                                       FileUploaded="UploadFileForSelectedDocumentAsync"
                                        AttachmentDownloadRequested="DownloadAttachmentAsync"
                                       AttachmentDeleted="DeleteAttachmentAsync"
                                       CommentAdded="AddCommentForSelectedDocumentAsync"
                                       CommentUpdated="UpdateCommentAsync"
                                       CommentDeleted="DeleteCommentAsync" />
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="HideDocumentModal">닫기</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_newDocumentModal">
    <ModalContent Centered="true" Scrollable="true" Size="ModalSize.ExtraLarge">
        <ModalHeader>
            <ModalTitle>새글 등록</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <OperationDocumentCreateForm @key="_newDocumentFormKey"
                                         DocumentType="@DocumentType"
                                         CurrentUserName="@_currentUserName"
                                         CurrentDisplayName="@_currentDisplayName"
                                         DocumentCreated="RefreshDocumentsAfterCreateAsync" />
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="HideNewDocumentModal">닫기</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter, EditorRequired]
    public string DocumentType { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    private string _statusMessage = string.Empty;
    private Color _statusColor = Color.Success;
    private readonly Dictionary<int, List<OperationDocumentAttachment>> _attachmentsByDocument = new();
    private bool _isAdministrator;
    private string? _currentUserName;
    private string? _currentDisplayName;
    private List<OperationDocument> _documents = new();
    private List<OperationDocumentComment> _comments = new();
    private Dictionary<int, List<OperationDocumentComment>> _commentsByDocument = new();
    private Modal _documentModal = default!;
    private Modal _newDocumentModal = default!;
    private OperationDocument? _selectedDocument;
    private int _newDocumentFormKey;
    private int _selectedDocumentKey;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadDocumentsAsync();
        await LoadCommentsAsync();
        await LoadAttachmentsAsync();
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAdministrator = user.IsInRole(RoleConstants.Administrator);
        _currentUserName = user.Identity?.Name;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            _currentDisplayName = null;
            return;
        }

        using var context = DbFactory.CreateDbContext();
        _currentDisplayName = await context.Users
            .Where(u => u.Id == userId)
            .Select(u => u.Name)
            .FirstOrDefaultAsync();
    }

    private void OpenDocumentModal(OperationDocument document)
    {
        _selectedDocument = document;
        _selectedDocumentKey++;
        _documentModal.Show();
    }

    private void HideDocumentModal()
    {
        _documentModal.Hide();
    }

    private void OpenNewDocumentModal()
    {
        _newDocumentFormKey++;
        _newDocumentModal.Show();
    }

    private void HideNewDocumentModal()
    {
        _newDocumentModal.Hide();
    }

    private async Task RefreshDocumentsAfterCreateAsync()
    {
        await LoadDocumentsAsync();
        await LoadCommentsAsync();
        await LoadAttachmentsAsync();
    }

    private async Task UpdateSelectedDocumentAsync(string updatedContent)
    {
        if (_selectedDocument is null)
        {
            return;
        }

        var documentId = _selectedDocument.Id;
        await UpdateDocumentAsync(documentId, updatedContent);
        _selectedDocument = _documents.FirstOrDefault(document => document.Id == documentId);
    }

    private async Task DeleteSelectedDocumentAsync()
    {
        if (_selectedDocument is null)
        {
            return;
        }

        var documentId = _selectedDocument.Id;
        await DeleteDocumentAsync(documentId);

        if (_documents.All(document => document.Id != documentId))
        {
            _selectedDocument = null;
            HideDocumentModal();
        }
    }

    private Task UploadFileForSelectedDocumentAsync(FileUploadEventArgs e)
    {
        return _selectedDocument is null
            ? Task.CompletedTask
            : OnFileUploadAsync(_selectedDocument.Id, e);
    }

    private Task DownloadAttachmentAsync(int attachmentId)
    {
        Navigation.NavigateTo($"operation-documents/attachments/{attachmentId}/download", forceLoad: true);
        return Task.CompletedTask;
    }

    private Task AddCommentForSelectedDocumentAsync(string inputComment)
    {
        return _selectedDocument is null
            ? Task.CompletedTask
            : AddCommentAsync(_selectedDocument.Id, inputComment);
    }

    private async Task AddCommentAsync(int operationDocumentId, string inputComment)
    {
        if (string.IsNullOrWhiteSpace(inputComment))
        {
            _statusColor = Color.Danger;
            _statusMessage = "댓글을 입력하세요.";
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var comment = new OperationDocumentComment
        {
            OperationDocumentId = operationDocumentId,
            Comment = inputComment.Trim(),
            CreatedAt = TimeZoneHelper.GetKoreaTimeNow(),
            AuthorUserName = _currentUserName,
            AuthorName = _currentDisplayName
        };

        context.OperationDocumentComments.Add(comment);
        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "댓글이 저장되었습니다.";

        await LoadCommentsAsync();
    }

    private async Task OnFileUploadAsync(int operationDocumentId, FileUploadEventArgs e)
    {
        var rootPath = Configuration["FileStorage:RootPath"];

        if (string.IsNullOrWhiteSpace(rootPath))
        {
            _statusColor = Color.Danger;
            _statusMessage = "파일 저장소 경로가 설정되지 않았습니다.";
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var document = await context.OperationDocuments
            .AsNoTracking()
            .Where(d => d.Id == operationDocumentId)
            .Select(d => new { d.Id, d.AuthorUserName })
            .FirstOrDefaultAsync();

        if (document is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "첨부할 문서를 찾을 수 없습니다.";
            return;
        }

        if (!IsCurrentUserAuthor(document.AuthorUserName))
        {
            _statusColor = Color.Danger;
            _statusMessage = "문서 작성자만 파일을 첨부할 수 있습니다.";
            return;
        }

        try
        {
            var absoluteRootPath = Path.GetFullPath(rootPath);
            Directory.CreateDirectory(absoluteRootPath);

            var extension = Path.GetExtension(e.File.Name);
            var storedFileName = $"{Guid.NewGuid():N}{extension}";
            var absoluteFilePath = Path.Combine(absoluteRootPath, storedFileName);

            await using (var fileStream = new FileStream(absoluteFilePath, FileMode.Create, FileAccess.Write, FileShare.None))
            {
                await e.File.OpenReadStream(long.MaxValue).CopyToAsync(fileStream);
            }

            var relativePath = Path.GetRelativePath(absoluteRootPath, absoluteFilePath)
                .Replace("\\", "/");

            var attachment = new OperationDocumentAttachment
            {
                OperationDocumentId = operationDocumentId,
                OriginalFileName = e.File.Name,
                StoredFileName = storedFileName,
                RelativePath = relativePath,
                UploadedAt = TimeZoneHelper.GetKoreaTimeNow()
            };

            context.OperationDocumentAttachments.Add(attachment);
            await context.SaveChangesAsync();

            _statusColor = Color.Success;
            _statusMessage = "파일이 업로드되었습니다.";

            await LoadAttachmentsAsync();
        }
        catch (Exception)
        {
            _statusColor = Color.Danger;
            _statusMessage = "파일 업로드 중 오류가 발생했습니다.";
        }

        StateHasChanged();
    }

    private async Task DeleteDocumentAsync(int operationDocumentId)
    {
        using var context = DbFactory.CreateDbContext();
        var document = await context.OperationDocuments
            .FirstOrDefaultAsync(d => d.Id == operationDocumentId);

        if (document is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "삭제할 문서를 찾을 수 없습니다.";
            return;
        }

        if (!CanManageDocument(document))
        {
            _statusColor = Color.Danger;
            _statusMessage = "본인이 작성한 문서만 삭제할 수 있습니다.";
            return;
        }

        var confirmed = await MessageService.Confirm("문서와 해당 댓글을 모두 삭제하시겠습니까?", "삭제 확인", options =>
        {
            options.ConfirmButtonText = "삭제";
            options.CancelButtonText = "취소";
        });

        if (!confirmed)
        {
            return;
        }

        var attachments = await context.OperationDocumentAttachments
            .Where(a => a.OperationDocumentId == operationDocumentId)
            .ToListAsync();

        var rootPath = Configuration["FileStorage:RootPath"];
        if (!string.IsNullOrWhiteSpace(rootPath))
        {
            var absoluteRootPath = Path.GetFullPath(rootPath);

            foreach (var attachment in attachments)
            {
                var normalizedRelativePath = attachment.RelativePath.Replace('/', Path.DirectorySeparatorChar);
                var absoluteFilePath = Path.GetFullPath(Path.Combine(absoluteRootPath, normalizedRelativePath));

                if (absoluteFilePath.StartsWith(absoluteRootPath, StringComparison.OrdinalIgnoreCase)
                    && File.Exists(absoluteFilePath))
                {
                    File.Delete(absoluteFilePath);
                }
            }
        }

        context.OperationDocuments.Remove(document);
        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "문서와 종속된 댓글/첨부 파일이 삭제되었습니다.";

        await LoadDocumentsAsync();
        await LoadCommentsAsync();
        await LoadAttachmentsAsync();
    }

    private async Task DeleteAttachmentAsync(int attachmentId)
    {
        using var context = DbFactory.CreateDbContext();
        var attachment = await context.OperationDocumentAttachments
            .Include(a => a.OperationDocument)
            .FirstOrDefaultAsync(a => a.Id == attachmentId);

        if (attachment is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "삭제할 첨부 파일을 찾을 수 없습니다.";
            return;
        }

        if (!_isAdministrator && !IsCurrentUserAuthor(attachment.OperationDocument.AuthorUserName))
        {
            _statusColor = Color.Danger;
            _statusMessage = "업로드한 사용자만 첨부 파일을 삭제할 수 있습니다.";
            return;
        }

        var confirmed = await MessageService.Confirm("첨부 파일을 삭제하시겠습니까?", "삭제 확인", options =>
        {
            options.ConfirmButtonText = "삭제";
            options.CancelButtonText = "취소";
        });

        if (!confirmed)
        {
            return;
        }

        var rootPath = Configuration["FileStorage:RootPath"];

        if (!string.IsNullOrWhiteSpace(rootPath))
        {
            var absoluteRootPath = Path.GetFullPath(rootPath);
            var normalizedRelativePath = attachment.RelativePath.Replace('/', Path.DirectorySeparatorChar);
            var absoluteFilePath = Path.GetFullPath(Path.Combine(absoluteRootPath, normalizedRelativePath));

            if (absoluteFilePath.StartsWith(absoluteRootPath, StringComparison.OrdinalIgnoreCase)
                && File.Exists(absoluteFilePath))
            {
                File.Delete(absoluteFilePath);
            }
        }

        context.OperationDocumentAttachments.Remove(attachment);
        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "첨부 파일이 삭제되었습니다.";

        await LoadAttachmentsAsync();
    }

    private async Task UpdateDocumentAsync(int documentId, string updatedContent)
    {
        using var context = DbFactory.CreateDbContext();
        var document = await context.OperationDocuments
            .FirstOrDefaultAsync(d => d.Id == documentId);

        if (document is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "수정할 문서를 찾을 수 없습니다.";
            return;
        }

        if (!CanManageDocument(document))
        {
            _statusColor = Color.Danger;
            _statusMessage = "본인이 작성한 문서만 수정할 수 있습니다.";
            return;
        }

        if (string.IsNullOrWhiteSpace(updatedContent))
        {
            _statusColor = Color.Danger;
            _statusMessage = "문서 내용을 입력하세요.";
            return;
        }

        document.Content = updatedContent.Trim();
        document.UpdatedAt = TimeZoneHelper.GetKoreaTimeNow();

        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "문서가 수정되었습니다.";

        await LoadDocumentsAsync();
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        using var context = DbFactory.CreateDbContext();
        var comment = await context.OperationDocumentComments
            .FirstOrDefaultAsync(c => c.Id == commentId);

        if (comment is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "삭제할 댓글을 찾을 수 없습니다.";
            return;
        }

        if (!CanManageComment(comment))
        {
            _statusColor = Color.Danger;
            _statusMessage = "본인이 작성한 댓글만 삭제할 수 있습니다.";
            return;
        }

        var confirmed = await MessageService.Confirm("댓글을 삭제하시겠습니까?", "삭제 확인", options =>
        {
            options.ConfirmButtonText = "삭제";
            options.CancelButtonText = "취소";
        });

        if (!confirmed)
        {
            return;
        }

        context.OperationDocumentComments.Remove(comment);
        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "댓글이 삭제되었습니다.";

        await LoadCommentsAsync();
    }

    private async Task UpdateCommentAsync(OperationDocumentComment commentUpdate)
    {
        using var context = DbFactory.CreateDbContext();
        var comment = await context.OperationDocumentComments
            .FirstOrDefaultAsync(c => c.Id == commentUpdate.Id);

        if (comment is null)
        {
            _statusColor = Color.Danger;
            _statusMessage = "수정할 댓글을 찾을 수 없습니다.";
            return;
        }

        if (!CanManageComment(comment))
        {
            _statusColor = Color.Danger;
            _statusMessage = "본인이 작성한 댓글만 수정할 수 있습니다.";
            return;
        }

        var updatedComment = commentUpdate.Comment;
        if (string.IsNullOrWhiteSpace(updatedComment))
        {
            _statusColor = Color.Danger;
            _statusMessage = "댓글을 입력하세요.";
            return;
        }

        comment.Comment = updatedComment.Trim();
        comment.CreatedAt = TimeZoneHelper.GetKoreaTimeNow();

        await context.SaveChangesAsync();

        _statusColor = Color.Success;
        _statusMessage = "댓글이 수정되었습니다.";

        await LoadCommentsAsync();
    }

    private async Task LoadDocumentsAsync()
    {
        using var context = DbFactory.CreateDbContext();

        var query = context.OperationDocuments
            .AsNoTracking()
            .Where(d => d.DocumentType == DocumentType);

        _documents = await query
            .OrderByDescending(d => d.UpdatedAt)
            .ThenByDescending(d => d.Id)
            .ToListAsync();
    }

    private async Task LoadCommentsAsync()
    {
        if (_documents.Count == 0)
        {
            _comments = new List<OperationDocumentComment>();
            _commentsByDocument = new Dictionary<int, List<OperationDocumentComment>>();
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var operationDocumentIds = _documents.Select(d => d.Id).ToList();

        _comments = await context.OperationDocumentComments
            .AsNoTracking()
            .Where(c => operationDocumentIds.Contains(c.OperationDocumentId))
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();

        _commentsByDocument = _comments
            .GroupBy(c => c.OperationDocumentId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private async Task LoadAttachmentsAsync()
    {
        _attachmentsByDocument.Clear();

        if (_documents.Count == 0)
        {
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var operationDocumentIds = _documents.Select(d => d.Id).ToList();

        var attachments = await context.OperationDocumentAttachments
            .AsNoTracking()
            .Where(a => operationDocumentIds.Contains(a.OperationDocumentId))
            .OrderByDescending(a => a.UploadedAt)
            .ToListAsync();

        foreach (var group in attachments.GroupBy(a => a.OperationDocumentId))
        {
            _attachmentsByDocument[group.Key] = group.ToList();
        }
    }

    private List<OperationDocumentAttachment> GetAttachmentsForDocument(int operationDocumentId)
    {
        return _attachmentsByDocument.TryGetValue(operationDocumentId, out var attachments)
            ? attachments
            : new List<OperationDocumentAttachment>();
    }

    private List<OperationDocumentComment> GetCommentsForDocument(int operationDocumentId)
    {
        return _commentsByDocument.TryGetValue(operationDocumentId, out var comments)
            ? comments
            : new List<OperationDocumentComment>();
    }

    private bool CanManageDocument(OperationDocument document)
    {
        return _isAdministrator || IsCurrentUserAuthor(document.AuthorUserName);
    }

    private bool CanManageComment(OperationDocumentComment comment)
    {
        return _isAdministrator || IsCurrentUserAuthor(comment.AuthorUserName);
    }

    private bool IsCurrentUserAuthor(string? authorUserName)
    {
        return !string.IsNullOrWhiteSpace(_currentUserName)
            && !string.IsNullOrWhiteSpace(authorUserName)
            && string.Equals(_currentUserName, authorUserName, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatAuthor(string? userName, string? name)
    {
        var safeUserName = string.IsNullOrWhiteSpace(userName) ? "Unknown" : userName;
        var safeName = string.IsNullOrWhiteSpace(name) ? "Unknown" : name;
        return $"{safeUserName} ({safeName})";
    }
}
