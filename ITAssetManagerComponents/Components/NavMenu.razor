@inject NavigationManager Navigation
@inject AntiforgeryStateProvider Antiforgery

<Bar Mode="BarMode.VerticalInline"
     CollapseMode="BarCollapseMode.Small"
     Breakpoint="Breakpoint.Desktop"
     NavigationBreakpoint="Breakpoint.Tablet">
    <BarToggler>
        <Div Position="Position.Absolute.Top.Is0.Start.Is0" Background="Background.White" Width="Width.Is100" Height="Height.Is100">
            <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Bars"
                     Position="Position.Absolute.Top.Is50.Start.Is50.Translate.Middle"
                     IconSize="IconSize.Large"
                     TextColor="TextColor.Primary" />
        </Div>
    </BarToggler>
    <BarBrand>
        <BarItem>
            <BarLink To="/" Match="Match.All" TextWeight="TextWeight.Bold" TextColor="TextColor.Primary">
                <Image Source="_content/ITAssetManagerComponents/images/brand.jpg" Text="Brand Logo" Width="Width.Is50" Margin="Margin.Is1" />                
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarMenu>
        <BarStart>
            <BarItem>
                <BarLink To="/" Match="Match.All">
                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Home" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                    대시보드
                </BarLink>
            </BarItem>
            <AuthorizeView>
                <Authorized>
                    <BarItem>
                        <BarLink To="/schedule">
                            <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.CalendarPlus" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                            @HeaderConstant.SecheduleCalendarTitle
                        </BarLink>
                    </BarItem>
                    <BarItem>
                        <BarDropdown>
                            <BarDropdownToggle Clicked="@(() => Navigation.NavigateTo("/servers"))">
                                <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.FolderPlus" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                관리항목
                            </BarDropdownToggle>
                            <BarDropdownMenu>
                                <BarDropdownItem To="/servers">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Server" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.ServerTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/storages">
                                    <BarIcon IconName="@("fa-hard-drive")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.StorageTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/networkequipments">
                                    <BarIcon IconName="@("fa-network-wired")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.NetworkEquipmentTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/securityequipments">
                                    <BarIcon IconName="@("fa-user-secret")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.SecurityEquipmentTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/softwares">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.CompactDisc" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.SoftwareTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/supportequipments">
                                    <BarIcon IconName="@("fa-toolbox")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.SupportEquipmentTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/miscellaneousequipments">
                                    <BarIcon IconName="@("fa-ethernet")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.EtcTitle
                                </BarDropdownItem>
                            </BarDropdownMenu>
                        </BarDropdown>
                    </BarItem>
                    <BarItem>
                        <BarDropdown>
                            <BarDropdownToggle Clicked="@(() => Navigation.NavigateTo("/fault"))">
                                <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.ChartBar" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                유지관리현황
                            </BarDropdownToggle>
                            <BarDropdownMenu>
                                <BarDropdownItem To="/fault">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.HeartBroken" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.FaultTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/securityvulnerability">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Bug" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.VulnerabilityTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/routinecheck">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.CalendarCheck" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.ScheduledMaintenanceTitle
                                </BarDropdownItem>
                                <BarDropdownItem To="/maintenance">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Wrench" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    @HeaderConstant.MaintenanceTitle
                                </BarDropdownItem>
                            </BarDropdownMenu>
                        </BarDropdown>
                    </BarItem>
                    <BarItem>
                        <BarDropdown>
                            <BarDropdownToggle>
                                <BarIcon IconName="@("fa-folder-open")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                운영관리문서
                            </BarDropdownToggle>
                            <BarDropdownMenu>
                                <BarDropdownItem To="/operationdocs/workrequest">
                                    <BarIcon IconName="@("fa-file-signature")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    작업요청
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/routinecheck">
                                    <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.CalendarCheck" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    정기점검
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/regularpm">
                                    <BarIcon IconName="@("fa-tools")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    정기PM
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/operationmanual">
                                    <BarIcon IconName="@("fa-book")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    운영메뉴얼
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/systemstatus">
                                    <BarIcon IconName="@("fa-chart-line")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    시스템현황
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/emergencycontact">
                                    <BarIcon IconName="@("fa-phone-alt")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    비상연락망
                                </BarDropdownItem>
                                <BarDropdownItem To="/operationdocs/etc">
                                    <BarIcon IconName="@("fa-ellipsis-h")" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                    기타
                                </BarDropdownItem>
                            </BarDropdownMenu>
                        </BarDropdown>
                    </BarItem>
                    <BarItem>
                        <BarLink To="/servicelevelagreements">
                            <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.ClipboardCheck" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                            @HeaderConstant.ServiceLevelAgreementTitle
                        </BarLink>
                    </BarItem>
                    <!-- Administrator menu -->
                    <AuthorizeView Policy="@PolicyConstants.ADMINISTRATOR_POLICY" Context="adminContext">
                        <Authorized Context="adminAuthorized">
                            <BarItem>
                                <BarDropdown>
                                    <BarDropdownToggle>
                                        <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.UserCog" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                        관리자
                                    </BarDropdownToggle>
                                    <BarDropdownMenu>
                                        <BarDropdownItem To="/admin/usermanagement">
                                            <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Users" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                            사용자 관리
                                        </BarDropdownItem>
                                        <BarDropdownItem To="/admin/excelmanagement">
                                            <BarIcon IconName="Blazorise.Icons.FontAwesome.FontAwesomeIcons.FileExcel" Width="Width.Px(25)" TextAlignment="TextAlignment.Center" />
                                            @HeaderConstant.ExcelDataManagementTitle
                                        </BarDropdownItem>
                                    </BarDropdownMenu>
                                </BarDropdown>
                            </BarItem>
                        </Authorized>
                    </AuthorizeView>
                </Authorized>
            </AuthorizeView>
        </BarStart>
    </BarMenu>
</Bar>



